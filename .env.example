# Resend — leave blank to dry-run (UI still works, nothing is sent).
RESEND_API_KEY=
RESEND_FROM_EMAIL=COAir <noreply@coair.ai>

# Portal URLs — set all three in production for subdomain routing.
# Marketing site stays on https://coair.ai (separate from this app).
NEXT_PUBLIC_LOGIN_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_USER_URL=http://localhost:3002
# Legacy alias for user-facing asset links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Proxied through Next at /coair-api → FastAPI on :8000
COAIR_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_COAIR_API_BASE=/coair-api

# Stripe — leave blank to keep dummy checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase Auth (browser). Anon key is public; RLS blocks table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_AUTH_EMAIL_DOMAIN=users.coair.local

# Production example:
# NEXT_PUBLIC_LOGIN_URL=https://login.coair.ai
# NEXT_PUBLIC_ADMIN_URL=https://admin.coair.ai
# NEXT_PUBLIC_USER_URL=https://user.coair.ai
# NEXT_PUBLIC_APP_URL=https://user.coair.ai
# Add all three app subdomains to Supabase Auth → Redirect URLs.
