# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
.idea/
.vscode/

# lockfile: use npm (package-lock.json) for Vercel
yarn.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/tooling artifacts
.impeccable/
.superpowers/
.mcp.json

# API runtime data (when using /api subfolder)
api/data/
api/storage/
!api/storage/schemas/
!api/storage/schemas/**
api/cache/
api/logs/
api/qdrant_storage/
api/qdrant_snapshots/
api/.env
api/.env.local
api/.env.production

# Local paste files with secrets — never commit
deploy/render.env.paste
**/render.env.paste
