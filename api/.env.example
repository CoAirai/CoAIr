# API Keys (required)
GOOGLE_API_KEY=your_google_api_key_here

# Model policy: all Chatbot/Chronology reasoning uses Gemini 3.6 Flash.
# Only upload-time OCR/metadata/classification uses Gemini 2.5 Flash-Lite.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_INGESTION_MODEL=gemini-2.5-flash-lite
# Read-only directory mounted by Docker; files contain dedicated per-user keys.
GOOGLE_USER_KEY_DIR=/run/secrets/google_keys

# Optional extra LLM providers. Adding these keys alone no longer fans out
# every query to multiple models — that only happens when ENABLE_DUAL_PROVIDER
# is also true. Leave it off in production to avoid the per-query cost multiplier.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ENABLE_DUAL_PROVIDER=false
MAX_LLM_CALLS=12
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
CHRONOLOGY_PIPELINE_VERSION=v2
CHRONOLOGY_V3_DEMO_ENABLED=true

# Ingest-time master event memory. Production Cloud Run must use Cloud SQL
# PostgreSQL; local development falls back to storage/master_events DuckDB.
EVENT_DATABASE_URL=
EVENT_DB_POOL_MIN=0
EVENT_DB_POOL_MAX=5
EVENT_INDEX_ENABLED=true
EVENT_INDEX_MAX_CONCURRENCY=1
EVENT_HIGH_RISK_VERIFIER_ENABLED=true
CHRONOLOGY_EVENT_DISCOVERY_MODE=audit

# Vector store. "qdrant" is self-hosted and starts with `docker compose up`;
# "pinecone" is the legacy hosted path and needs an account of your own.
VECTOR_STORE_BACKEND=qdrant

# Free local BGE/FastEmbed vectors for both uploaded documents and queries.
# Keep this stable for an existing collection; changing embedding families
# requires rebuilding that collection.
EMBEDDING_PROVIDER=fastembed

# Qdrant. The URL below is the compose service name; use localhost:6333 when
# running uvicorn directly against the container.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=local-dev-key
QDRANT_COLLECTION=coair_local

# Legacy Pinecone path — only when VECTOR_STORE_BACKEND=pinecone.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=hybrid-rag

# Authentication (required)
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_DAYS=7

# Text LLM provider: gemini (default) or zai
# LLM_PRIMARY_PROVIDER=gemini
# Z.AI — free GLM models via OpenAI-compatible API (https://z.ai)
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.7-flash
# ZAI_MODEL_LITE=glm-4.5-flash

# Browser origins allowed to call the API cross-origin, comma separated.
# Unset = the local dev defaults (localhost:3000, localhost:3002, localhost:5173).
# The bundled SPA is same-origin and never needs this; a separately hosted
# client (e.g. an admin panel) does. "*" will not work — credentials are on, so
# each origin must be listed in full.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

# OCR Settings (optional)
OCR_MODE=auto
OCR_LANG=eng
OCR_DPI=200

# OCR Detection Thresholds (optional)
OCR_MIN_CHARS=30
OCR_MIN_ALPHA_RATIO=0.2
OCR_IMAGE_COVERAGE=0.7
OCR_MAX_PAGES=500

# Product flags
FORENSIC_NATIVE_UI_V1=true
COAIR_USAGE_LIMIT_USD=100

# Optional Redis (LLM cache + usage tracker)
# REDIS_URL=redis://localhost:6379/0

# Object storage (S3 takes precedence over GCS). Empty = local disk under data/
S3_BUCKET_NAME=coairsuite-aws-s3-uae
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=

# Email — leave blank to keep dry-run (no messages sent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=COAir <noreply@coair.ai>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe — test keys (sk_test_/pk_test_). Empty = dummy fulfill (no redirect).
# Webhook secret optional; confirm via Checkout success URL session_id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Login uses Supabase Auth when these keys are set (AUTH_PROVIDER=supabase).
# Tests keep AUTH_PROVIDER=local via pytest. JWT_SECRET remains for local/test tokens only.
# AUTH_PROVIDER=supabase
# Paste the Supabase "Transaction pooler" URI (port 6543). When set, SQLite files
# under storage/ are ignored for those stores. Qdrant remains the vector backend.
#
# Option A — full URI:
#   SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Option B — compose from password (set region if not eu-central-1):
#   SUPABASE_DB_PASSWORD=your-db-password
#   SUPABASE_DB_REGION=eu-central-1
#
# EVENT_DATABASE_URL defaults to the same URI when unset.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser origins for invite/reset emails and portal links.
COAIR_LOGIN_URL=http://localhost:3002
COAIR_USER_URL=http://localhost:3002
COAIR_ADMIN_URL=http://localhost:3002
COAIR_APP_URL=http://localhost:3002
# Production example:
# COAIR_LOGIN_URL=https://login.coair.ai
# COAIR_USER_URL=https://user.coair.ai
# COAIR_ADMIN_URL=https://admin.coair.ai
# COAIR_APP_URL=https://user.coair.ai
# COAIR_EMAIL_RELAY_URL=https://login.coair.ai/api/email/send
# CORS_ORIGINS=https://login.coair.ai,https://admin.coair.ai,https://user.coair.ai
# Comma-separated emails that become platform superadmin on first Supabase sign-in.
SUPERADMIN_EMAIL=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=eu-central-1
DATABASE_URL=
