# Copy the selected production configuration securely. Preserve IDs/providers.
# This template is intentionally incomplete and must not replace production secrets.
APP_MODE=api
PORT=8000
VECTOR_STORE_BACKEND=qdrant
QDRANT_COLLECTION=coair
QDRANT_API_KEY=replace-with-existing-restored-key
EMBEDDING_PROVIDER=fastembed
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LLM_PRIMARY_PROVIDER=gemini
GOOGLE_API_KEY=
JWT_SECRET=
# The 4-GiB host keeps search working memory bounded without reducing corpus
# coverage. DuckDB may spill to the persistent disk; no API container RAM cap.
COAIR_DUCKDB_MEMORY_LIMIT=512MB
COAIR_DUCKDB_THREADS=2
# Preserve the actual production AUTH_PROVIDER, relational connection, payment,
# email, model, project/corpus and object-storage configuration from its owner.
