# Merge into the PRIVATE target api.env, never the source production environment.
# The target image must include this branch's pinned Azure dependencies.
OBJECT_STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://replaceaccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=coair-staging
# Optional: client ID of a user-assigned managed identity; empty uses system identity.
AZURE_CLIENT_ID=
# Only the exact original bucket/container used by existing canonical references.
# Do not set a different project's bucket as a shortcut to missing documents.
AZURE_MIGRATION_SOURCE_S3_BUCKET=
AZURE_MIGRATION_SOURCE_GCS_BUCKET=
# Restored persistent local DB/catalog/registry is authoritative. Do not replace
# it with an older mirror at startup. Originals still download on demand.
OBJECT_STORAGE_RESTORE_ON_STARTUP=false
# Preserve the source's qualified settings; these are the English default profile.
OCR_MODE=auto
OCR_ENGINE=tesseract
OCR_LANG=eng
OCR_DPI=200
OCR_MAX_WORKERS=1
OCR_MAX_PAGES=500
# Preserve the actual production multimodal fallback policy/credentials.
# No OCR reprocessing is required just to copy byte-identical originals.
