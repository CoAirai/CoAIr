# Reuse the already-validated ARM64/GB10 CUDA stack. Weights ship inside the image.
FROM vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1
COPY --from=embedding-model /config.json /model.safetensors /tokenizer.json /tokenizer_config.json /special_tokens_map.json /vocab.txt /models/
COPY embedding_server.py /srv/embedding_server.py
ENV HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
ENTRYPOINT ["python3", "/srv/embedding_server.py"]
