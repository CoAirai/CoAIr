Port 2222
ListenAddress ${TAILSCALE_IP}
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /run/sshd-coair-tunnel.pid
AuthorizedKeysFile /etc/coair/tunnel-keys/%u
AllowGroups coair-tunnel
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
UsePAM yes
MaxSessions 0
PermitTTY no
AllowTcpForwarding local
PermitOpen 127.0.0.1:${APP_PORT}
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitUserRC no
GatewayPorts no
ClientAliveInterval 30
ClientAliveCountMax 3
LogLevel VERBOSE
