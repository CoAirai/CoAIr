# A flattened runtime filesystem contains no inherited source-bearing layers.
FROM scratch
COPY rootfs/ /
WORKDIR /app
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata FASTEMBED_CACHE_PATH=/opt/coair/models/fastembed PORT=8080 APP_MODE=api
EXPOSE 8080
CMD ["python", "-c", "from coair_protected import run; run()"]
